{
  "name": "git-visit",
  "version": "4.1.0",
  "description": "Git command line wrapping library to git visit commit history",
  "main": "index.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test nyc --reporter=text-summary mocha --recursive --throw-deprecation",
    "coverage": "nyc report --reporter=text-lcov | coveralls",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "standard-version"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saintedlama/git-visit.git"
  },
  "author": "Christoph Walcher <christoph.walcher@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/saintedlama/git-visit/issues"
  },
  "homepage": "https://github.com/saintedlama/git-visit",
  "dependencies": {
    "debug": "^4.4.3",
    "diff2html": "^3.4.56",
    "fs-extra": "^11.4.0",
    "opted": "^1.0.2",
    "trim-left": "^2.0.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "coveralls": "^3.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "file-url": "^4.0.0",
    "mocha": "^11.8.0",
    "mocha-lcov-reporter": "^1.3.0",
    "nyc": "^18.0.0",
    "standard-version": "^9.5.0"
  }
